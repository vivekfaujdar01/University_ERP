NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://mongo:27017/university_erp

# JWT
JWT_SECRET=change_me_jwt_secret_32chars_minimum
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Payment Gateways
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@university.edu

# Client
CLIENT_URL=http://localhost:3000

# PDF
PDF_TEMPLATE_DIR=./src/templates
