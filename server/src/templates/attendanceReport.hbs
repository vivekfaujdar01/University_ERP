<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Batch Attendance Report — {{batchName}}</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; color: #111; background: #fff; padding: 24px; }
    h1 { font-size: 18px; font-weight: 700; color: #1e3a8a; margin-bottom: 2px; }
    .meta { color: #4b5563; font-size: 11px; margin-bottom: 16px; border-bottom: 2px solid #e5e7eb; padding-bottom: 8px; }
    .stats-summary { display: flex; gap: 16px; margin-bottom: 16px; background: #f8fafc; padding: 12px; rounded-radius: 8px; border: 1px solid #e2e8f0; }
    .stat-box { flex: 1; text-align: center; }
    .stat-val { font-size: 16px; font-weight: 700; color: #0f172a; }
    .stat-label { font-size: 10px; color: #64748b; text-transform: uppercase; }
    table { width: 100%; border-collapse: collapse; margin-top: 8px; }
    th { background: #1e40af; color: #fff; padding: 8px 10px; font-size: 11px; font-weight: 600; text-align: left; }
    td { border: 1px solid #e5e7eb; padding: 6px 8px; font-size: 10px; }
    tr:nth-child(even) { background-color: #f9fafb; }
    tr.defaulter-row { background-color: #fef2f2 !important; }
    .status-badge { display: inline-block; padding: 2px 6px; border-radius: 4px; font-weight: 600; font-size: 9px; }
    .badge-ok { background: #dcfce7; color: #15803d; }
    .badge-alert { background: #fee2e2; color: #b91c1c; }
    footer { margin-top: 24px; font-size: 10px; color: #9ca3af; border-top: 1px solid #e5e7eb; padding-top: 8px; }
    .page-num { float: right; }
  </style>
</head>
<body>
  <h1>University ERP — Batch Attendance Report</h1>
  <div class="meta">
    Batch: <strong>{{batchName}}</strong> &nbsp;|&nbsp;
    Academic Year: <strong>{{academicYear}}</strong> &nbsp;|&nbsp;
    Generated: {{generatedAt}}
  </div>

  <div class="stats-summary">
    <div class="stat-box">
      <div class="stat-val">{{totalSessions}}</div>
      <div class="stat-label">Total Conducted Sessions</div>
    </div>
    <div class="stat-box">
      <div class="stat-val">{{totalStudents}}</div>
      <div class="stat-label">Enrolled Students</div>
    </div>
    <div class="stat-box">
      <div class="stat-val" style="color:#dc2626">{{defaulterCount}}</div>
      <div class="stat-label">Defaulters (&lt;75%)</div>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Enrollment No.</th>
        <th>Student Name</th>
        <th style="text-align:center">Attended / Total</th>
        <th style="text-align:center">Attendance %</th>
        <th style="text-align:center">Status</th>
      </tr>
    </thead>
    <tbody>
      {{#each studentStats}}
      <tr class="{{#if this.isDefaulter}}defaulter-row{{/if}}">
        <td>{{@index}}</td>
        <td>{{this.enrollmentNumber}}</td>
        <td><strong>{{this.name}}</strong></td>
        <td style="text-align:center">{{this.attendedClasses}} / {{this.totalClasses}}</td>
        <td style="text-align:center; font-weight:bold; {{#if this.isDefaulter}}color:#dc2626{{/if}}">
          {{this.percentage}}%
        </td>
        <td style="text-align:center">
          {{#if this.isDefaulter}}
          <span class="status-badge badge-alert">DEFAULTER (&lt;75%)</span>
          {{else}}
          <span class="status-badge badge-ok">OK (&ge;75%)</span>
          {{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <footer>
    University ERP System &nbsp;|&nbsp; Confidential Document
    <span class="page-num">Page 1</span>
  </footer>
</body>
</html>
